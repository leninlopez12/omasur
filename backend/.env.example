# =====================================================================
#  I OMASUR UNI 2026 — variables del servidor
#  Copie este archivo como .env y complete los valores.
#  El .env NUNCA se sube al repositorio.
# =====================================================================

# --- Entorno ---------------------------------------------------------
# "production" en el servidor. En su computadora déjelo vacío.
NODE_ENV=
PORT=3001

# --- Base de datos ---------------------------------------------------
DATABASE_URL="postgresql://usuario:clave@localhost:5432/omasur?schema=public"

# --- Sesiones --------------------------------------------------------
# Genere una clave larga y al azar. Con esta línea:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Si la cambia, todas las sesiones abiertas se cierran.
# En producción el servidor NO arranca si falta o tiene menos de 32 letras.
JWT_SECRET=""
JWT_EXPIRES="7d"

# --- Direcciones -----------------------------------------------------
# Dirección pública del sitio, sin barra al final. De aquí sale el enlace
# que va en el correo para recuperar la contraseña, así que en producción
# NO puede quedar vacío: los enlaces saldrían apuntando a localhost.
SITIO_URL="https://omasur.ipeh.edu.pe"
# Solo si la web se sirve desde OTRO dominio que la API. Si el servidor
# entrega también la web (lo normal aquí), déjelo vacío.
FRONTEND_URL=""
# Carpeta con la web compilada. Vacío = ../frontend/dist
WEB_DIST=""
# true detrás de un proxy (Render, Railway, Nginx). Si no, false.
# Mal puesto, el límite de intentos de ingreso se puede burlar.
TRUST_PROXY=false

# --- Cuentas de la comisión -----------------------------------------
# Solo se crean la primera vez, con la base vacía. Cambiar estos valores
# después NO cambia la contraseña de una cuenta que ya existe: eso se
# hace desde "¿Olvidó su contraseña?".
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_DNI=""
SUPERVISOR_EMAIL=""
SUPERVISOR_PASSWORD=""
SUPERVISOR_DNI=""

# --- Precios de inscripción -----------------------------------------
PRECIO_ESTATAL=12
PRECIO_PARTICULAR=17

# --- Avisos del navegador (opcional) --------------------------------
# Generar con: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_CONTACTO="mailto:correo@ejemplo.com"

# --- Cloudflare R2 ---------------------------------------------------
# Guarda comprobantes, fondos, el QR de Yape y las bases.
# Sin estos valores todo cae en la carpeta uploads/ del servidor, que en
# producción se borra en cada despliegue: complételos.
# El bucket debe quedar PRIVADO; los archivos se entregan por la API.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="omasur-comprobantes"
# Solo si alguna vez expone el bucket con dominio público. Normalmente vacío.
R2_PUBLIC_URL=""

# --- Correo (recuperación de contraseña) -----------------------------
# Gmail: smtp.gmail.com / 587 / contraseña de aplicación de 16 letras.
# Brevo: smtp-relay.brevo.com / 587 / clave SMTP del panel.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="I OMASUR UNI 2026 <correo@ejemplo.com>"
RECUPERACION_MINUTOS=60
# Ruta del logo que va en la cabecera de los correos.
LOGO_CORREO=""
